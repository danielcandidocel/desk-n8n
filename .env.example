COMPOSE_PROJECT_NAME=desk-n8n

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=change-this-to-a-random-32-plus-character-string
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_SECURE_COOKIE=false
N8N_RUNNERS_ENABLED=true

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n

RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=desk
RABBITMQ_PASSWORD=desk
RABBITMQ_VHOST=/desk

DESK_APP_URL=http://host.docker.internal:8080
DESK_APP_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_ORG_ID=

VIRTUAL_AGENT_REQUEST_QUEUE=virtual-agent-requests
VIRTUAL_AGENT_RESPONSE_QUEUE=virtual-agent-responses
COPILOT_REQUEST_QUEUE=copilot-requests
COPILOT_RESPONSE_QUEUE=copilot-responses
RABBITMQ_EXCHANGE=desk.events
